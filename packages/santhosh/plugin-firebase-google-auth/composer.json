{
    "name": "santhosh/plugin-firebase-google-auth",
    "version": "1.0.0",
    "description": "NativePHP Mobile plugin for Google Sign-In with Firebase Authentication",
    "type": "nativephp-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Your Name",
            "email": "you@example.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "nativephp/mobile": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Santhosh\\FirebaseGoogleAuth\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Santhosh\\FirebaseGoogleAuth\\FirebaseGoogleAuthServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "require-dev": {
        "pestphp/pest": "^3.0"
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "beta"
}