{
    "name": "bbs/plugin-native-media-optimizer",
    "version": "1.0.0",
    "description": "Native Android image optimization, video processing and thumbnails for NativePHP Mobile.",
    "type": "nativephp-plugin",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "nativephp/mobile": "~4.2.0",
        "bbs/plugin-native-document-picker": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Bbs\\NativeMediaOptimizer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bbs\\NativeMediaOptimizer\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bbs\\NativeMediaOptimizer\\NativeMediaOptimizerServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml"
    }
}
