{
    "name": "bbs/plugin-firebase-google-auth",
    "version": "1.0.0",
    "description": "NativePHP Mobile plugin for Google Sign-In with Firebase Authentication",
    "namespace": "FirebaseGoogleAuth",
    "keywords": [],
    "category": "utilities",
    "license": "MIT",
    "pricing": {
        "type": "free"
    },
    "author": {
        "name": "BBS",
        "email": "you@example.com",
        "url": ""
    },
    "homepage": "",
    "repository": "",
    "funding": [],
    "platforms": [
        "android",
        "ios"
    ],
    "icon": "resources/icon.png",
    "screenshots": [],
    "bridge_functions": [
        {
            "name": "FirebaseGoogleAuth.SignIn",
            "android": "com.bbs.plugins.firebase_google_auth.FirebaseGoogleAuthFunctions.SignIn",
            "ios": "FirebaseGoogleAuthFunctions.SignIn",
            "description": "Start Google Sign-In and authenticate the credential with Firebase"
        },
        {
            "name": "FirebaseGoogleAuth.SignOut",
            "android": "com.bbs.plugins.firebase_google_auth.FirebaseGoogleAuthFunctions.SignOut",
            "ios": "FirebaseGoogleAuthFunctions.SignOut",
            "description": "Sign out from Firebase Authentication"
        }
    ],
    "android": {
        "min_version": 21,
        "permissions": [
            "android.permission.INTERNET"
        ],
        "repositories": [],
        "dependencies": {
            "implementation": [
                "com.google.firebase:firebase-auth",
                "androidx.credentials:credentials:1.3.0",
                "androidx.credentials:credentials-play-services-auth:1.3.0",
                "com.google.android.libraries.identity.googleid:googleid:1.1.1"
            ]
        },
        "activities": [],
        "services": [],
        "receivers": [],
        "providers": []
    },
    "ios": {
        "min_version": "15.0",
        "permissions": [],
        "repositories": [],
        "dependencies": {
            "swift_packages": [],
            "pods": []
        }
    },
    "assets": {
        "android": [],
        "ios": []
    },
    "secrets": [],
    "events": [
        "Bbs\\FirebaseGoogleAuth\\Events\\FirebaseGoogleAuthCompleted"
    ],
    "service_provider": "Bbs\\FirebaseGoogleAuth\\FirebaseGoogleAuthServiceProvider",
    "hooks": {
        "copy_assets": "nativephp:firebase-google-auth:copy-assets"
    }
}