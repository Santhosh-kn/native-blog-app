{
    "name": "bbs/plugin-firebase-remote-config",
    "version": "1.0.0",
    "description": "Bounded native Android Firebase Remote Config for NativePHP Mobile.",
    "type": "nativephp-plugin",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "nativephp/mobile": "~4.2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Bbs\\FirebaseRemoteConfig\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bbs\\FirebaseRemoteConfig\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bbs\\FirebaseRemoteConfig\\FirebaseRemoteConfigServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml"
    }
}
