{
    "name": "bbs/plugin-native-document-picker",
    "version": "1.0.0",
    "description": "Secure Android document selection and application-private persistence for NativePHP Mobile",
    "type": "nativephp-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "BBS",
            "email": "you@example.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "nativephp/mobile": "^4.2"
    },
    "autoload": {
        "psr-4": {
            "Bbs\\NativeDocumentPicker\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bbs\\NativeDocumentPicker\\NativeDocumentPickerServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "scripts": {
        "test": "phpunit --bootstrap tests/bootstrap.php tests/PluginTest.php"
    }
}
