{
    "name": "bbs/plugin-native-printing",
    "version": "1.0.0",
    "description": "Native PDF preview and printing for NativePHP Mobile",
    "type": "nativephp-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "BBS",
            "email": "you@example.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "nativephp/mobile": "^4.2"
    },
    "autoload": {
        "psr-4": {
            "Bbs\\NativePrinting\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bbs\\NativePrinting\\NativePrintingServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "scripts": {
        "test": "phpunit tests/PluginTest.php"
    }
}
