{
    "name": "bbs/plugin-native-calendar",
    "version": "1.0.0",
    "description": "Android calendar event editor and viewer integration for NativePHP Mobile.",
    "type": "nativephp-plugin",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "nativephp/mobile": "^4.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Bbs\\NativeCalendar\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bbs\\NativeCalendar\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bbs\\NativeCalendar\\NativeCalendarServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml"
    }
}
